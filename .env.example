# Public URL used for domain deployment
APP_URL=https://yourdomain.com
PUBLIC_APP_URL=https://yourdomain.com
PORT=4173

# Dedicated Neon Postgres connection for this offer.
# Use the pooled URL for the application and the unpooled URL for maintenance.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Protect /api/webhooks/jvzoo?secret=...
WEBHOOK_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret

# Email automation (Resend)
RESEND_API_KEY=
EMAIL_FROM=WifiCode <hello@yourdomain.com>

# SMS automation (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Authorize.Net production or sandbox
AUTHORIZE_NET_ENV=production
AUTHORIZE_NET_API_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
AUTHORIZE_NET_PUBLIC_CLIENT_KEY=

# Zen Dashboard reporting (chargeback history and status synchronization)
ZEN_ACCESS_TOKEN=
ZEN_DBA_ID=
