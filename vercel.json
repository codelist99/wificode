{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{member.html,**/*.html,public/**}",
      "maxDuration": 30
    }
  },
  "crons": [{ "path": "/api/cron/email", "schedule": "* * * * *" }],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.wificode.dev" }],
      "destination": "https://wificode.dev/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index?__path=/$1" }
  ]
}
